<!DOCTYPE html>
<html>
<head>
    <title>Secure Form Example</title>
</head>
<body>
    <h1>Create a New Entry</h1>
    
    <form method="post">
        {% csrf_token %}
        
        {{ form.as_p }}
        
        <button type="submit">Submit Securely</button>
    </form>

    <p><a href="{% url 'book_list' %}">Back to Library</a></p>
</body>
</html>